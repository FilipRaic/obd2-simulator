(module RK12L12C0A0G (layer F.Cu) (tedit 68B1A101)
	(descr "Alps RK12L12C0A0G, 12 mm snap-in rotacijski potenciometar, dvostruki element, 10k, karakteristika 15A (logaritamska), hod 300 stupnjeva. Vertical type: osovina stoji OKOMITO na plocu i gleda prema gore. Geometrija prema katalogu RK12L str. 358, redak 2: tijelo 12 x 12 mm (13 mm preko snap-in jezicaka), OS OSOVINE LEZI U RAVNINI SNAP-IN UTORA, tijelo se od te ravnine pruza jos 6 mm dalje od terminala i 9,5 mm prema ravnini nalijeganja. Rupe: 6 x 0.8 u jednom redu na koraku 2 mm (raspon 10), unutarnji element R2 = padovi 1/2/3, vanjski R1 = 11/12/13, snap-in utori 2.0 x 2.1 na razmaku 13 mm i 11 mm iza reda terminala, te dvije nemetalizirane rupe 1.6 mm za lokacijske izbocine, 5 mm iza utora (izmjereno na stvarnom dijelu 05.08.2026.). Crtez rupa je nacrtan s montazne strane, pa redanje terminala gledano odozgo moze biti zrcaljeno.")
	(tags "potentiometer Alps RK12L snap-in vertical")
	(fp_text reference REF** (at 0.000 -18.700) (layer F.SilkS)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(fp_text value RK12L12C0A0G (at 0.000 2.600) (layer F.Fab)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(fp_text user %R (at 0 -11.0) (layer F.Fab)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	# Obris tijela: 12 x 15,5 mm, od ravnine nalijeganja (y = -1,5) do daljnjeg
	# ruba (y = -17). Os osovine je na y = -11, u ravnini snap-in utora.
	# Obris je prekinut ondje gdje bi presao preko vlastitih padova: bocne
	# stranice preskacu snap-in utore (y -12,55..-9,45) i lokacijske rupe
	# (y -16,8..-15,2), a gornja stranica je skracena da ne dodje nad njih.
	(fp_line (start -5.0 -17.0) (end 5.0 -17.0) (layer F.SilkS) (width 0.15))
	(fp_line (start -6.0 -14.8) (end -6.0 -13.0) (layer F.SilkS) (width 0.15))
	(fp_line (start 6.0 -14.8) (end 6.0 -13.0) (layer F.SilkS) (width 0.15))
	(fp_line (start -6.0 -9.0) (end -6.0 -1.5) (layer F.SilkS) (width 0.15))
	(fp_line (start 6.0 -9.0) (end 6.0 -1.5) (layer F.SilkS) (width 0.15))
	(fp_line (start -6.0 -1.5) (end 6.0 -1.5) (layer F.SilkS) (width 0.15))
	(fp_line (start -6.0 -17.0) (end 6.0 -17.0) (layer F.Fab) (width 0.1))
	(fp_line (start 6.0 -17.0) (end 6.0 -1.5) (layer F.Fab) (width 0.1))
	(fp_line (start 6.0 -1.5) (end -6.0 -1.5) (layer F.Fab) (width 0.1))
	(fp_line (start -6.0 -1.5) (end -6.0 -17.0) (layer F.Fab) (width 0.1))
	# Osovina: promjer 6 mm, okomito prema gore, u ravnini utora.
	(fp_circle (center 0 -11.0) (end 3.0 -11.0) (layer F.Fab) (width 0.1))
	(fp_text user "osovina gore" (at 0 -14.2) (layer F.Fab)
		(effects (font (size 0.8 0.8) (thickness 0.12)))
	)
	(fp_circle (center -5.0 1.9) (end -4.7 1.9) (layer F.SilkS) (width 0.3))
	(fp_line (start -7.0 -17.5) (end 7.0 -17.5) (layer F.CrtYd) (width 0.05))
	(fp_line (start 7.0 -17.5) (end 7.0 1.5) (layer F.CrtYd) (width 0.05))
	(fp_line (start 7.0 1.5) (end -7.0 1.5) (layer F.CrtYd) (width 0.05))
	(fp_line (start -7.0 1.5) (end -7.0 -17.5) (layer F.CrtYd) (width 0.05))
	(pad 12 thru_hole circle (at -5.0 0.0) (size 1.6 1.6) (drill 1.0) (layers *.Cu *.Mask))
	(pad 11 thru_hole circle (at -3.0 0.0) (size 1.6 1.6) (drill 1.0) (layers *.Cu *.Mask))
	(pad 1 thru_hole circle (at -1.0 0.0) (size 1.6 1.6) (drill 1.0) (layers *.Cu *.Mask))
	(pad 2 thru_hole circle (at 1.0 0.0) (size 1.6 1.6) (drill 1.0) (layers *.Cu *.Mask))
	(pad 3 thru_hole circle (at 3.0 0.0) (size 1.6 1.6) (drill 1.0) (layers *.Cu *.Mask))
	(pad 13 thru_hole circle (at 5.0 0.0) (size 1.6 1.6) (drill 1.0) (layers *.Cu *.Mask))
	(pad MP thru_hole oval (at -6.5 -11.0) (size 3.0 3.1) (drill oval 2.0 2.1) (layers *.Cu *.Mask))
	(pad MP thru_hole oval (at 6.5 -11.0) (size 3.0 3.1) (drill oval 2.0 2.1) (layers *.Cu *.Mask))
	# Lokacijske izbocine: samo mehanicko pozicioniranje, bez bakra i bez neta.
	(pad "" np_thru_hole circle (at -6.5 -16.0) (size 1.6 1.6) (drill 1.6) (layers *.Cu *.Mask))
	(pad "" np_thru_hole circle (at 6.5 -16.0) (size 1.6 1.6) (drill 1.6) (layers *.Cu *.Mask))
)
